<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- 签名身份必须与主 App（TrollStore.entitlements.plist）完全一致。
         Apple DTS 明确要求：内嵌扩展与宿主 App 的 Team Prefix 必须相同，
         否则 pluginkit 无法把扩展关联到宿主，启动隧道时报
         NEVPNConnectionErrorDomain code=14 / “Developer must update app”。
         TrollStore 重签会保留二进制中嵌入的这些 entitlements。 -->
    <key>application-identifier</key>
    <string>TROLLTROLL.com.prism.proxy.PrismVPN</string>
    <key>com.apple.developer.team-identifier</key>
    <string>TROLLTROLL</string>
    <key>platform-application</key>
    <true/>
    <!-- build 145 恢复 no-sandbox（build 142 的归因已修正）：Code=14 的
         真凶是 PrismHelper selfHelper 用残缺字典覆盖了 TrollStore 官方
         注册表（build 138/140 带 no-sandbox 时期注册同样成功，appex=6
         证明 pkd 并未拒绝免沙盒扩展）。恢复后扩展可畅通读写 App Group
         下的 prism_config.json / 心跳 / 错误文件，不再被沙盒静默拦截。
         memory.increased-memory-limit：申请提升网络扩展 Jetsam 内存上限
         （官方 key 为 kernel.*，此处两个变体都带上以兼容不同系统版本）。 -->
    <key>com.apple.private.security.no-sandbox</key>
    <true/>
    <key>com.apple.private.security.storage.AppDataContainers</key>
    <true/>
    <key>com.apple.developer.memory.increased-memory-limit</key>
    <true/>
    <key>com.apple.developer.kernel.increased-memory-limit</key>
    <true/>
    <key>com.apple.developer.networking.networkextension</key>
    <array>
        <string>packet-tunnel-provider</string>
    </array>
    <!-- App Group 共享容器（与主 App 一致），扩展从 group container
         读取主 App 写入的配置文件 -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.prism.proxy</string>
    </array>
</dict>
</plist>
