<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- 签名身份必须与主 App（TrollStore.entitlements.plist）完全一致。
         Apple DTS 明确要求：内嵌扩展与宿主 App 的 Team Prefix 必须相同，
         否则 pluginkit 无法把扩展关联到宿主，启动隧道时报
         NEVPNConnectionErrorDomain code=14 / “Developer must update app”。
         TrollStore 重签会保留二进制中嵌入的这些 entitlements。 -->
    <key>application-identifier</key>
    <string>TROLLTROLL.com.prism.proxy.PrismVPN</string>
    <key>com.apple.developer.team-identifier</key>
    <string>TROLLTROLL</string>
    <!-- platform-application：巨魔环境下让父子进程（appex 经
         nesessionmanager 拉起）通过 CS_PLATFORM_BINARY 校验。 -->
    <key>platform-application</key>
    <true/>
    <!-- no-sandbox + storage.AppDataContainers（build 138 实证必须）：
         任何进程在 main() 之前都要跑 _libsecinit_initializer，它会向
         secinitd 请求 PluginKit 沙盒容器目录（pkdDir）。TrollStore 安装
         不走 installd，pkdDir=absent，secinitd 拒绝初始化 → appex 在
         startTunnel 第一行之前 brk 自杀 → NE code=12 (pluginFailed)。
         与主 App（rtEnt=noSbx=1 同款）一致后 libsecinit 直接跳过沙盒
         初始化；storage.AppDataContainers 保留直读 App Group/数据容器
         的能力（工作目录/geo 数据库/心跳文件全在 group 容器内）。 -->
    <key>com.apple.private.security.no-sandbox</key>
    <true/>
    <key>com.apple.private.security.storage.AppDataContainers</key>
    <true/>
    <key>com.apple.developer.networking.networkextension</key>
    <array>
        <string>packet-tunnel-provider</string>
    </array>
    <!-- App Group 共享容器（与主 App 一致），扩展从 group container
         读取主 App 写入的配置文件 -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.prism.proxy</string>
    </array>
</dict>
</plist>
