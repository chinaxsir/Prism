<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- 签名身份必须与主 App（TrollStore.entitlements.plist）完全一致。
         Apple DTS 明确要求：内嵌扩展与宿主 App 的 Team Prefix 必须相同，
         否则 pluginkit 无法把扩展关联到宿主，启动隧道时报
         NEVPNConnectionErrorDomain code=14 / “Developer must update app”。
         TrollStore 重签会保留二进制中嵌入的这些 entitlements。 -->
    <key>application-identifier</key>
    <string>TROLLTROLL.com.prism.proxy.PrismVPN</string>
    <key>com.apple.developer.team-identifier</key>
    <string>TROLLTROLL</string>
    <key>platform-application</key>
    <true/>
    <!-- 注意：绝不能加 no-sandbox / storage.AppDataContainers（build 142
         实证死锁解法）：pkd 校验插件注册字典时发现网络扩展企图免沙盒
         运行，违反 App Extension 安全底线，当场静默拒绝注册
         （pluginIdentity无 → code 14）。build 133 不加 no-sandbox 报
         code 12 的真正根因是 pkdDir=absent（无容器目录 → 沙盒初始化
         崩溃）；该问题已由 PrismHelper 以 container-manager 权限提前
         开辟插件数据容器解决（pkdDir=present），无需再用 no-sandbox
         作弊。主 App 的 TrollStore.entitlements.plist 保持不变。 -->
    <key>com.apple.developer.networking.networkextension</key>
    <array>
        <string>packet-tunnel-provider</string>
    </array>
    <!-- App Group 共享容器（与主 App 一致），扩展从 group container
         读取主 App 写入的配置文件 -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.prism.proxy</string>
    </array>
</dict>
</plist>
