<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- TrollStore 安装时会从主二进制提取本文件作为 entitlements。
	     绝不能包含 get-task-allow / task_for_pid-allow / com.apple.private.cs.debugger
	     等受限键，否则 iOS 16+ 会要求开启“开发者模式”（未开启即闪退）。
	     TrollStore 会用 CoreTrust 漏洞重新签名整个 app。 -->
	<key>application-identifier</key>
	<string>TROLLTROLL.com.prism.proxy</string>
	<key>com.apple.developer.team-identifier</key>
	<string>TROLLTROLL</string>
	<!-- NETunnelProviderManager 调用方必须内嵌此权限，否则
	     loadAllFromPreferences / startVPNTunnel 报 -1。
	     TrollStore 重签会保留（与扩展端 entitlement 一致）。 -->
	<key>com.apple.developer.networking.networkextension</key>
	<array>
		<string>packet-tunnel-provider</string>
	</array>
	<!-- App Group 共享容器：主 App 写配置到 group container，
	     扩展从同一路径读取（避开 providerConfiguration 512KB 限制）。
	     TrollStore 可签任意 group ID，无需 Apple 注册。 -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.prism.proxy</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>TROLLTROLL.com.prism.proxy</string>
	</array>
	<!-- 注意：绝不能加 com.apple.private.security.container-required。
	     build 134-136 曾为修 noCnt 诊断误加此键，结果给 no-sandbox 的
	     主 App 强行触发 Seatbelt 容器限制，废掉了全盘读取能力：
	     /var/mobile/Library 与 /var/containers/Bundle/Application 均
	     不可访问 → rootHelper=TrollStore未定位、pkdDB=mobLib不可枚举
	     （build 133 时可枚举 156 项）。诊断里的 noCnt=- 检查的是
	     no-container（为 - 是正常的），不是 container-required。 -->
	<!-- TrollStore 平台特权（仅主 App）——官方 README "Unsandboxing" 完整配方：
	     1) platform-application：no-sandbox/no-container 正常工作的前提，
	        缺它时单加 no-sandbox/no-container 会导致启动即被杀
	        （build 116-118 "Failed to open" 实测根因）
	     2) no-sandbox：逃逸沙箱（README 推荐，保留数据容器——
	        no-container 会让 UIKit/UserDefaults 启动时访问容器失败）
	     3) storage.AppDataContainers：README 明示 no-sandbox +
	        platform-application 时访问自身数据容器所需
	     4) persona-mgmt：root persona spawn（pluginkit 注册用），
	        README 前提即 "app is not sandboxed"
	     产物：主 App 可逃逸沙箱执行 /usr/bin/pluginkit -a，
	     把 PlugIns/PrismVPN.appex 注册进 pkd（TrollStore 安装不走
	     installd，pkd 不会自动登记扩展，缺注册即 code=14）。 -->
	<key>platform-application</key>
	<true/>
	<key>com.apple.private.security.no-sandbox</key>
	<true/>
	<!-- container-manager：调用 MCMPluginKitPluginDataContainer /
	     MCMAppDataContainer / MCMSharedDataContainer 创建插件/数据容器
	     时，containermanagerd 强制要求调用方带此权限（TrollStore 官方
	     trollstorehelper 必带）。缺失时返回 nil → pkdDir=absent
	     （build 140 实证）。PrismHelper 与主 App 共用本 entitlements 签名。 -->
	<key>com.apple.private.security.container-manager</key>
	<true/>
	<key>com.apple.private.security.storage.AppDataContainers</key>
	<true/>
	<key>com.apple.private.persona-mgmt</key>
	<true/>
</dict>
</plist>
