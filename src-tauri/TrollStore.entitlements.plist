<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- TrollStore 安装时会从主二进制提取本文件作为 entitlements。
	     绝不能包含 get-task-allow / task_for_pid-allow / com.apple.private.cs.debugger
	     等受限键，否则 iOS 16+ 会要求开启“开发者模式”（未开启即闪退）。
	     TrollStore 会自动补 com.apple.private.security.container-required，
	     并用 CoreTrust 漏洞重新签名整个 app。 -->
	<key>application-identifier</key>
	<string>TROLLTROLL.com.prism.proxy</string>
	<key>com.apple.developer.team-identifier</key>
	<string>TROLLTROLL</string>
	<!-- NETunnelProviderManager 调用方必须内嵌此权限，否则
	     loadAllFromPreferences / startVPNTunnel 报 -1。
	     TrollStore 重签会保留（与扩展端 entitlement 一致）。 -->
	<key>com.apple.developer.networking.networkextension</key>
	<array>
		<string>packet-tunnel-provider</string>
	</array>
	<!-- App Group 共享容器：主 App 写配置到 group container，
	     扩展从同一路径读取（避开 providerConfiguration 512KB 限制）。
	     TrollStore 可签任意 group ID，无需 Apple 注册。 -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.prism.proxy</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>TROLLTROLL.com.prism.proxy</string>
	</array>
	<!-- 平台特权键（no-sandbox / no-container / persona-mgmt）已全部移除：
	     build 116-118 三种组合均导致启动即死（"Failed to open"，无崩溃日志），
	     而本文件在 build 114 状态（即当前内容）验证过可正常启动。
	     由排除法：Swift 改动不在启动路径，entitlements 是唯一变量。
	     结论：平台特权键与本 App 的 application-groups /
	     networkextension entitlement 组合在 iOS 16.5 上 exec 期被杀。
	     后续若需 sandbox 逃逸做 pkd 注册，须换路线（如 root helper），
	     不能再往本 plist 加平台特权键。 -->
</dict>
</plist>
